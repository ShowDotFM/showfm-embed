{
	"name": "@showfm/embed",
	"version": "1.7.0",
	"description": "show.fm web components: the embeddable podcast player.",
	"license": "MIT",
	"author": "show.fm Ltd",
	"homepage": "https://github.com/ShowDotFM/showfm-embed#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShowDotFM/showfm-embed.git"
	},
	"bugs": {
		"url": "https://github.com/ShowDotFM/showfm-embed/issues"
	},
	"keywords": [
		"show.fm",
		"podcast",
		"audio-player",
		"web-components",
		"custom-elements",
		"svelte"
	],
	"type": "module",
	"packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/*.test.*",
		"custom-elements.json",
		"fixtures/fallback"
	],
	"sideEffects": [
		"./dist/index.js",
		"./dist/cdn/*.js",
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js"
		},
		"./jsx-react": {
			"types": "./dist/jsx/react.d.ts",
			"default": "./dist/jsx/react.js"
		},
		"./jsx-preact": {
			"types": "./dist/jsx/preact.d.ts",
			"default": "./dist/jsx/preact.js"
		},
		"./jsx-solid": {
			"types": "./dist/jsx/solid.d.ts",
			"default": "./dist/jsx/solid.js"
		},
		"./cdn/v1.js": "./dist/cdn/v1.js",
		"./cdn/chunks/*": "./dist/cdn/chunks/*",
		"./cdn/click-loader.js": "./dist/cdn/click-loader.js",
		"./cdn/click-loader-local.js": "./dist/cdn/click-loader-local.js",
		"./cdn/v1-fallback.css": "./dist/cdn/v1-fallback.css",
		"./cdn/locales/*": "./dist/cdn/locales/*",
		"./fixtures/fallback/*": "./fixtures/fallback/*",
		"./custom-elements.json": "./custom-elements.json",
		"./package.json": "./package.json"
	},
	"customElements": "custom-elements.json",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:contract": "vitest run --project contract",
		"test:watch": "vitest",
		"test:browser": "playwright test",
		"cem": "node scripts/cem.mjs",
		"cem:check": "node scripts/cem.mjs --check",
		"elements": "node scripts/elements-md.mjs",
		"elements:check": "node scripts/elements-md.mjs --check",
		"size": "size-limit",
		"publint": "publint --strict",
		"attw": "attw --pack . --profile esm-only --exclude-entrypoints ./svelte ./cdn/v1.js ./cdn/chunks/* ./cdn/click-loader.js ./cdn/click-loader-local.js ./cdn/v1-fallback.css ./cdn/locales/* ./fixtures/fallback/* ./custom-elements.json ./package.json",
		"jsx:check": "tsc -p fixtures/jsx/react/tsconfig.json && tsc -p fixtures/jsx/preact/tsconfig.json && tsc -p fixtures/jsx/solid/tsconfig.json",
		"changeset": "changeset",
		"release": "node scripts/publish.mjs"
	},
	"peerDependencies": {
		"svelte": "^5.56.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.31.1",
		"@eslint/js": "^9.39.5",
		"@fontsource/geist-sans": "^5.3.0",
		"@fontsource/merriweather": "^5.3.0",
		"@fontsource/oswald": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"@size-limit/file": "^12.1.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/jest-axe": "^3.5.9",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jest-axe": "^10.0.0",
		"jsdom": "^27.4.0",
		"preact": "^10.29.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.25",
		"size-limit": "^12.1.0",
		"solid-js": "^1.9.16",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.6",
		"terser": "^5.51.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
